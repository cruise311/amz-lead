# amz-lead 环境变量配置模板
# 复制为 .env.local 并填入真实值（.gitignore 已忽略 .local 文件）

# ========== 探迹（必填，补号阶段需要） ==========
AMZ_LEAD_TUNGEE_USERNAME=your_tungee_username
AMZ_LEAD_TUNGEE_PASSWORD=your_tungee_password

# ========== 天眼查（选填，兜底查询） ==========
AMZ_LEAD_TYC_API_KEY=your_tyc_api_key

# ========== 企查查（选填，兜底查询） ==========
AMZ_LEAD_QCC_API_KEY=your_qcc_api_key

# ========== 代理（选填，采集阶段建议配置） ==========
# 格式：http://user:pass@host:port 或 socks5://user:pass@host:port
AMZ_LEAD_PROXY_URL=

# ========== 数据存储（选填，默认 data/） ==========
AMZ_LEAD_DATA_ROOT=data

# ========== 日志级别（选填：DEBUG/INFO/WARNING/ERROR） ==========
AMZ_LEAD_LOG_LEVEL=INFO

# ========== 监控告警 Webhook（选填） ==========
# 支持钉钉/飞书/企业微信/Slack 等标准 Webhook
AMZ_LEAD_MONITORING_WEBHOOK_URL=